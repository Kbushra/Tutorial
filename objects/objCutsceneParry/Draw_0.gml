draw_set_halign(fa_center);

if flag == 0 { draw_text(objTutorialDude.x+12, objTutorialDude.y-20, "DUDE."); }
else if flag == 1 { draw_text(objTutorialDude.x+12, objTutorialDude.y-20, "HOW."); }
else if flag == 2 { draw_text(objTutorialDude.x+12, objTutorialDude.y-20, "WHATEVER, BYE"); }

draw_set_halign(fa_left);